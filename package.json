{
  "name": "sharesies-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "collect": "node --env-file-if-exists=.env src/collector/run.ts",
    "import:csv": "node --env-file-if-exists=.env scripts/import-csv.ts",
    "detect-transfers": "node --env-file-if-exists=.env scripts/detect-transfers.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "spike": "node --env-file-if-exists=.env scripts/spike-akahu.ts",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.ts",
    "seed:demo:reset": "node --env-file-if-exists=.env scripts/seed-demo.ts --reset",
    "api": "node --env-file-if-exists=.env src/api/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/api/server.ts",
    "schedule": "node --env-file-if-exists=.env src/scheduler/run.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.6.14",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.8.3"
  }
}
