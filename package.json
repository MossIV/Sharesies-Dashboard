{
  "name": "sharesies-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "migrate": "node src/db/migrate.ts",
    "collect": "node src/collector/run.ts",
    "import:csv": "node scripts/import-csv.ts",
    "detect-transfers": "node scripts/detect-transfers.ts",
    "seed:demo": "node scripts/seed-demo.ts",
    "seed:demo:reset": "node scripts/seed-demo.ts --reset",
    "api": "node src/api/server.ts",
    "dev": "node --watch src/api/server.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.8.3"
  }
}
