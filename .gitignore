node_modules/
.env
.env.local

# SQLite database + WAL sidecars. This is the only copy of the history
# (Akahu cannot re-serve past values) so it is deliberately NOT tracked,
# but it must be backed up. See README.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

web/dist/
dist/
*.log

# Database backups (npm run backup). Local copies of the history, not source.
backups/

# Raw Akahu captures from `npm run spike`. The credentials, ids, account number
# and payment reference are redacted, but the balances and every holding are the
# real ones: a financial statement, not a fixture. They stay on this machine.
# A sanitized fixture meant for committing is named fixtures/akahu-accounts.sanitized.json.
fixtures/akahu-accounts.spike-*.json
fixtures/akahu-accounts.real.json

# Compose files are configuration, not source. A working one carries this machine's
# host paths, ports and volume mounts — on the NAS that includes the share name and
# the folders the history lives in — and a copied one is the easiest place for a
# real path to end up in the repository. The templates are committed instead:
#   docker-compose.example.yml            local
#   deploy/qnap/docker-compose.example.yml   QNAP Container Station
# Copy whichever applies to `docker-compose.yml` and edit it there.
docker-compose.yml
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.example.yml
