# Copy to .env and fill in. Never commit .env.
# Tokens live at https://my.akahu.nz (Developers page) after you create a
# personal app and connect Sharesies.

# The "app token" goes in the X-Akahu-Id header.
AKAHU_APP_TOKEN=

# The "user token" goes in the Authorization header.
AKAHU_USER_TOKEN=

# Where the SQLite file lives (relative paths resolve from the repo root).
DB_PATH=data/sharesies.db

# Portfolio source: akahu | manual
# Falls back to "manual" automatically when the Akahu tokens are absent,
# so the dashboard is usable before Phase 0 is complete.
PORTFOLIO_SOURCE=

# Only used by the manual source: a manually-typed current portfolio value.
MANUAL_VALUE_NZD=
MANUAL_ACCOUNT_NAME=Sharesies (manual)

# API server
API_PORT=8787

# Domain tuning defaults; can be overridden per-request and in the settings table.
ASSUMED_ANNUAL_RETURN=0.07
ASSUMED_MONTHLY_CONTRIBUTION=500

# ---------------------------------------------------------------- not announcing
# Milestone announcements (plan section 10). Leave NOTIFY_ENABLED unset and only
# the console channel runs. Set NOTIFY_CHANNELS to choose explicitly; a channel
# named without its settings is reported as a problem rather than silently skipped.
# Known channels: console, webhook, ntfy, email
NOTIFY_ENABLED=
NOTIFY_CHANNELS=

# webhook: any JSON endpoint (Home Assistant, Zapier, your own script)
NOTIFY_WEBHOOK_URL=

# ntfy: free push to your phone. Pick a long random topic and subscribe to the
# same topic in the ntfy app. The topic name is the only secret, so treat it as one.
NOTIFY_NTFY_TOPIC=
NOTIFY_NTFY_SERVER=https://ntfy.sh
NOTIFY_NTFY_TOKEN=

# email: plain SMTP. 465 is implicit TLS, 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# ------------------------------------------------------------ import and detection
# The path to a downloaded Sharesies transaction report. Only used when
# PORTFOLIO_SOURCE=csv (see src/sources/CsvSource.ts).
CSV_FILE=
CSV_ACCOUNT_NAME=Sharesies (report)

# Which connection counts as the portfolio (substring, case-insensitive).
AKAHU_CONNECTION_MATCH=sharesies
AKAHU_ACCOUNT_TYPES=INVESTMENT,WALLET

# Bank transfer detection: the words that appear on your bank statement for a
# transfer to your provider, and the connections that are the provider itself
# (movements inside those are not new money).
TRANSFER_KEYWORDS=sharesies
TRANSFER_EXCLUDE_CONNECTIONS=
