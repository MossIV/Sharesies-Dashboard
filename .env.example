# Copy to .env and fill in. Never commit .env.
# Tokens live at https://my.akahu.nz (Developers page) after you create a
# personal app and connect Sharesies.

# The "app token" goes in the X-Akahu-Id header.
AKAHU_APP_TOKEN=

# The "user token" goes in the Authorization header.
AKAHU_USER_TOKEN=

# Where the SQLite file lives (relative paths resolve from the repo root).
# A blank value means the default below. The container pins this to
# /data/sharesies.db regardless, because this value is right for a local run and
# wrong inside a container (it would resolve to /app/data, outside the volume).
DB_PATH=data/sharesies.db

# Portfolio source: akahu | manual
# Falls back to "manual" automatically when the Akahu tokens are absent,
# so the dashboard is usable before Phase 0 is complete.
PORTFOLIO_SOURCE=

# Only used by the manual source: a manually-typed current portfolio value.
MANUAL_VALUE_NZD=
MANUAL_ACCOUNT_NAME=Sharesies (manual)

# API server
API_PORT=8787

# Domain tuning defaults; can be overridden per-request and in the settings table.
#
# ASSUMED_ANNUAL_RETURN is only the last resort. In order, the figure comes from the
# settings table, then this file, then the allocation-weighted long-run assumption
# derived from the holdings (src/domain/fund-returns.ts), then the built-in 7%. Leave
# it blank to keep the derived figure; set it to pin a number of your own.
ASSUMED_ANNUAL_RETURN=
ASSUMED_MONTHLY_CONTRIBUTION=500

# ---------------------------------------------------------------- not announcing
# Milestone announcements (plan section 10). Leave NOTIFY_ENABLED unset and only
# the console channel runs. Set NOTIFY_CHANNELS to choose explicitly; a channel
# named without its settings is reported as a problem rather than silently skipped.
# Known channels: console, webhook, ntfy, email
NOTIFY_ENABLED=
NOTIFY_CHANNELS=

# webhook: any JSON endpoint (Home Assistant, Zapier, your own script)
NOTIFY_WEBHOOK_URL=

# ntfy: free push to your phone. Pick a long random topic and subscribe to the
# same topic in the ntfy app. The topic name is the only secret, so treat it as one.
NOTIFY_NTFY_TOPIC=
NOTIFY_NTFY_SERVER=https://ntfy.sh
NOTIFY_NTFY_TOKEN=

# email: plain SMTP. 465 is implicit TLS, 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# ------------------------------------------------------------ import and detection
# The path to a downloaded Sharesies transaction report. Only used when
# PORTFOLIO_SOURCE=csv (see src/sources/CsvSource.ts).
CSV_FILE=
CSV_ACCOUNT_NAME=Sharesies (report)

# Which connection counts as the portfolio (substring, case-insensitive).
AKAHU_CONNECTION_MATCH=sharesies
AKAHU_ACCOUNT_TYPES=INVESTMENT,WALLET

# ---------------------------------------------------------------- currency (FX)
# A Sharesies transaction report states a currency per row, and one real export
# held NZD, USD and AUD rows in the same file. Converting them needs a rate for
# the row's own trade date, which is fetched from the ECB's reference rates via
# the free, keyless frankfurter.dev API, and cached in the database so a
# re-import needs no network access at all.
#
# Rows whose currency has no rate are left out and reported; they are never
# counted as NZD at par.
#
# FX_PROVIDER=none                          # switch conversion off entirely
# FX_ENABLED=false                          # the same thing, as a flag
# FX_API_BASE=https://api.frankfurter.dev/v1

# Bank transfer detection: the words that appear on your bank statement for a
# transfer to your provider, and the connections that are the provider itself
# (movements inside those are not new money).
TRANSFER_KEYWORDS=sharesies
TRANSFER_EXCLUDE_CONNECTIONS=

# ------------------------------------------------------- the unattended daily job
# `npm run schedule` runs the collector and then a backup, once a day, at this
# time in this zone. New Zealand's clocks change twice a year, so the hour is
# resolved against the offset in force on the day rather than a fixed interval.
SCHEDULE_HOUR_NZ=7
SCHEDULE_MINUTE_NZ=0
SCHEDULE_TIME_ZONE=Pacific/Auckland

# Where `npm run backup` and the scheduler put their copies, and how many to keep.
# BACKUP_DIR defaults to <repo>/backups; point it at a second disk if you have one.
# The container pins it to /backups (the mounted volume) for the same reason as
# DB_PATH above.
BACKUP_DIR=
BACKUP_KEEP=14
