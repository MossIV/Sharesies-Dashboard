# Copy to .env and fill in. Never commit .env.
# Tokens live at https://my.akahu.nz (Developers page) after you create a
# personal app and connect Sharesies.

# The "app token" goes in the X-Akahu-Id header.
AKAHU_APP_TOKEN=

# The "user token" goes in the Authorization header.
AKAHU_USER_TOKEN=

# Where the SQLite file lives (relative paths resolve from the repo root).
DB_PATH=data/sharesies.db

# Portfolio source: akahu | manual
# Falls back to "manual" automatically when the Akahu tokens are absent,
# so the dashboard is usable before Phase 0 is complete.
PORTFOLIO_SOURCE=

# Only used by the manual source: a manually-typed current portfolio value.
MANUAL_VALUE_NZD=
MANUAL_ACCOUNT_NAME=Sharesies (manual)

# API server
API_PORT=8787

# Domain tuning defaults; can be overridden per-request and in the settings table.
ASSUMED_ANNUAL_RETURN=0.07
ASSUMED_MONTHLY_CONTRIBUTION=500
